.icon {
  color: $success;
  margin-right: 1;
}

.muted {
  color: $text-muted;
}

CurrentPlaying {
  padding: 1 3;
  height: auto;
  layout: grid;
  grid-size: 3 4;
  grid-columns: 21 10 1fr;
  grid-rows: 3 auto auto 4;
  grid-gutter: 0 0;

  AlbumArt {
    width: 1fr;
    row-span: 4;
    layout: grid;
    height: 11;

    Image {
      width: auto;
      height: 14;
      border-bottom: block black 20%;
      border-right: block black 20%;
    }
  }

  TitleTrack {
    layout: horizontal;
    column-span: 2;
    margin-top: 1;
    color: $success;
    text-style: bold;
    .title {
      width: 1fr;
    }
    .status {
      color: auto;
      text-style: none;
    }
  }

  ProgressTracker {
    column-span: 2;
    margin-top: 1;
    margin-right: 2;
    layout: horizontal;

    ProgressBar {
      margin-right: 3;
    }

    ProgressBar,
    ProgressBar Bar {
      width: 1fr;
    }

    #lbl_position,
    #lbl_duration {
      width: 5;
    }

    Label {
      color: $text-muted;
    }
  }
}

TabbedContent {
  height: 1fr;
}

PlaylistWidget {
  height: 1fr;
  overflow-y: auto;
}

PlaylistAlbumWidget {
  border: $primary round 30%;
  padding: 0 1;
  height: auto;
  margin: 0 1;
  width: 1fr;
  layout: horizontal;

  &.current {
    background: $primary 10%;
    border: $primary round 80%;
  }

  AlbumArt {
    width: 10;
    height: 5;
    align: right top;
    margin-left: 1;

    Image {
      width: auto;
      max-width: 10;
      height: 4;
    }
  }

  .album-title {
    border-bottom: solid $primary 30%;
    height: 2;
    text-style: bold;

    .icon {
      color: $primary;
    }

    .year {
      width: 1fr;
      color: $text-muted 30%;
      margin-left: 2;
    }

    .duration {
      color: $text-muted 30%;
    }
  }

  Vertical {
    height: auto;
  }

  PlaylistSongWidget {
    height: auto;
    layout: horizontal;

    &.current Label {
      color: $success;
      text-style: bold;
    }

    &:focus Label {
      color: $text-primary !important;
      background: $primary-muted;
    }

    Playing {
      width: auto;
    }

    .track {
      color: $accent;
    }

    .artist,
    .label {
      color: $text-muted;
    }

    .title {
      width: 1fr;
    }

    .duration {
      color: $text-muted 30%;
    }
  }
}

Search {
  height: 1fr;

  Input {
    margin-bottom: 1;
  }

  SearchResults {
    height: 1fr;
    overflow-y: auto;

    AlbumArt {
      width: 8;
      height: 4;
      Image {
        height: 4;
        width: auto;
      }
    }

    .group {
      text-style: bold;
      color: $secondary;
      border-bottom: solid $secondary;
      width: 1fr;
      margin: 1 2 0 2;

      &:first-child {
        margin: 0 2 0 2;
      }
    }

    SearchResultArtist,
    SearchResultAlbum,
    SearchResultSong {
      height: auto;
      margin: 0 2;
      layout: horizontal;

      &:focus {
        background: $primary-muted;
        color: $text-primary;
      }

      Label {
        color: $foreground 50%;
      }

      Label.highlight {
        width: 1fr;
        text-style: bold;
        color: $foreground !important;
      }

      Vertical {
        height: auto;
        width: 1fr;
        border-bottom: tall $background-lighten-1;
        padding-left: 2;
        padding-top: 1;
        padding-right: 2;
      }
    }

    .empty {
      height: 1fr;
      width: 1fr;
      align: center middle;

      color: $foreground 50%;
    }
  }
}

Lyrics {
  width: 1fr;
  height: auto;

  Label {
  }
}
